# Copy file này thành .env.local và điền các giá trị thực tế

# ─── 1. GOOGLE GEMINI API (Khuyên dùng - Miễn phí 100% tại Google AI Studio) ───
# Đăng ký lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ─── 2. HOẶC DEEPSEEK API ───
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat

# ─── 3. HOẶC OPENAI / CÁC MÔ HÌNH TƯƠNG THÍCH OPENAI ───
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── CẤU HÌNH SITE ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
